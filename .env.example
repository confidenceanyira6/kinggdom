# VITE_USE_MOCK=true runs the app on in-memory sample data (no backend needed).
# Set VITE_USE_MOCK=false to use the live Supabase backend (project "quantumretailmanager", schema "kingdom").
VITE_USE_MOCK=true

# Public (browser-safe) values only. Never put service-role keys here.
# URL: https://fpflwkgqdmgmrvsukyop.supabase.co
# Key: the publishable/anon key from Supabase > Project Settings > API Keys.
VITE_SUPABASE_URL=https://fpflwkgqdmgmrvsukyop.supabase.co
VITE_SUPABASE_ANON_KEY=

# Show the Admin Panel entry (UI only; real access must be enforced server-side).
VITE_SHOW_ADMIN=false
