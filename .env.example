# VITE_USE_MOCK=true runs the app on in-memory sample data (no backend needed).
# Set to false once src/services/backendApi.ts is implemented.
VITE_USE_MOCK=true

# Public (browser-safe) keys only. Never put service-role keys here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Show the Admin Panel entry (UI only; real access must be enforced server-side).
VITE_SHOW_ADMIN=false
